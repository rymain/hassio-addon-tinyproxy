#!/command/with-contenv bashio
# shellcheck shell=bash
# Generates /var/run/tinyproxy.conf from add-on options, then execs tinyproxy
# in the foreground so s6 supervises it directly.
set -e

readonly CONF=/var/run/tinyproxy.conf

port=$(bashio::config 'port')
timeout=$(bashio::config 'timeout')
log_level=$(bashio::config 'log_level')
username=$(bashio::config 'basic_auth_username' '')
password=$(bashio::config 'basic_auth_password' '')

if bashio::var.is_empty "${username}" && ! bashio::var.is_empty "${password}"; then
    bashio::exit.nok "basic_auth_password is set but basic_auth_username is empty. Set both or neither; refusing to start."
fi
if ! bashio::var.is_empty "${username}" && bashio::var.is_empty "${password}"; then
    bashio::exit.nok "basic_auth_username is set but basic_auth_password is empty. Set both or neither; refusing to start."
fi

if ! bashio::config.has_value 'allow'; then
    bashio::exit.nok "The 'allow' list is empty. Refusing to start an unrestricted proxy."
fi

# ponytail: run as the unprivileged account the apk package creates; fall back
# to nobody if a future package build drops it.
proxy_user=tinyproxy
id -u tinyproxy >/dev/null 2>&1 || proxy_user=nobody

umask 077
{
    echo "User ${proxy_user}"
    echo "Group ${proxy_user}"
    echo "Port ${port}"
    echo "Timeout ${timeout}"
    echo "LogLevel ${log_level}"
    echo "MaxClients 100"
    echo "ViaProxyName \"tinyproxy\""
    echo "DefaultErrorFile \"/usr/share/tinyproxy/default.html\""
    echo "StatFile \"/usr/share/tinyproxy/stats.html\""
} > "${CONF}"

for cidr in $(bashio::config 'allow'); do
    case "${cidr}" in
        0.0.0.0/0|::/0)
            bashio::exit.nok "Refusing '${cidr}' in the allow list: that is an open proxy."
            ;;
    esac
    echo "Allow ${cidr}" >> "${CONF}"
    bashio::log.info "Allowing ${cidr}"
done

for cport in $(bashio::config 'connect_ports'); do
    echo "ConnectPort ${cport}" >> "${CONF}"
done

if ! bashio::var.is_empty "${username}"; then
    # Never logged: credentials go straight into the 0600 config file.
    echo "BasicAuth ${username} ${password}" >> "${CONF}"
    bashio::log.info "BasicAuth enabled for user '${username}'"
else
    bashio::log.warning "BasicAuth is disabled; access is restricted by the allow list only."
fi

bashio::log.info "Starting Tinyproxy on port ${port}..."
exec tinyproxy -d -c "${CONF}"
